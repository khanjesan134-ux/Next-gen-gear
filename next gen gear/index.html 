    <!-- Accepted Payment Methods Section -->
    <section class="py-12 px-6 max-w-7xl mx-auto text-center border-t border-slate-800/80">
        <h3 class="text-xl font-semibold text-white mb-6">যে পেমেন্ট মেথডগুলোতে পেমেন্ট গ্রহণ করা হয়:</h3>
        <div class="flex flex-wrap justify-center items-center gap-4 md:gap-6">
            <div class="glass-card px-5 py-3 rounded-xl flex items-center gap-2 text-pink-500 font-bold tracking-wide border border-pink-500/30">
