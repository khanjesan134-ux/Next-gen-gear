    <!-- JAVASCRIPT LOGIC -->
    <script>
        // ==========================================
        // ১. তোমার কন্টাক্ট সেটিংস
        // ==========================================
        const WHATSAPP_NUMBER = "8801984767917"; // তোমার হোয়াটসঅ্যাপ নাম্বার
        
        // তোমার গুগল শিট থেকে পাওয়া Published CSV লিংক:
        const GOOGLE_SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/1jlASOw7sagwq4OUeGqrsCO1E_guWwOS0cwiuI8sqGMY/export?format=csv"; 

        // ==========================================
        // ২. ডিফল্ট প্রোডাক্ট লিস্ট
        // ==========================================
        let products = [
            {
                id: 1,
                name: "Earphone",
                model: "FRB N-26",
                price: "regular price 1290 offer price 990",
                badge: "now available",
                image: "https://i.ibb.co.com/9Hps9pXF/img-6afc5b3a42d07-1-1794923322.png",
                desc: "অবিশ্বাস্য ৬০০ ঘণ্টার স্ট্যান্ডবাই ব্যাকআপ এবং লেটেস্ট Bluetooth 5.4 প্রযুক্তির নেকব্যান্ড।"
            }
        ];

        // ==========================================
        // ৩. প্রোডাক্ট কার্ড রেন্ডার ও ডেলিভারি টেবিল ফাংশন
        // ==========================================
        function renderProducts(productList) {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = '';

            productList.forEach(product => {
                const card = `
                    <div class="product-card glass-card rounded-2xl overflow-hidden flex flex-col justify-between" data-tilt data-tilt-max="8" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.2">
                        <div>
                            <div class="relative overflow-hidden group h-60">
                                <span class="absolute top-3 left-3 z-10 bg-sky-500 text-slate-950 text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                                    ${product.badge || 'স্টকে আছে'}
                                </span>
                                <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover transform group-hover:scale-110 transition duration-500">
                            </div>
                            <div class="p-6 space-y-3">
                                <div>
                                    <h3 class="text-xl font-bold text-white">${product.name}</h3>
                                    <p class="text-xs text-sky-400 font-semibold tracking-wide uppercase mt-1">মডেল: ${product.model || 'N/A'}</p>
                                </div>
                                <p class="text-slate-400 text-sm leading-relaxed">${product.desc}</p>
                                
                                <div class="pt-1">
                                    <span class="text-lg font-extrabold text-sky-400">${product.price}</span>
                                </div>

                                <!-- Delivery Charge Box (प्रत्येक প্রোডাক্টের নিচে শো করবে) -->
                                <div class="mt-4 p-3.5 rounded-xl bg-slate-900/80 border border-sky-500/20 text-xs space-y-2">
                                    <div class="flex items-center justify-between text-sky-300 font-bold border-b border-slate-800 pb-1.5">
                                        <span><i class="fas fa-truck-fast text-sky-400 mr-1.5"></i> ডেলিভারি চার্জ ও সময়:</span>
                                        <span class="text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded text-[10px]">সারা দেশ হোম ডেলিভারি</span>
                                    </div>
                                    <div class="space-y-1 text-slate-300">
                                        <div class="flex justify-between">
                                            <span>🏠 ঢাকা সিটি (Inside Dhaka):</span>
                                            <span class="font-semibold text-white">১-২ দিন | ৬০ TK</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span>🏘️ ঢাকা সাব এরিয়া (Sub Area):</span>
                                            <span class="font-semibold text-white">১-২ দিন | ১০০ TK</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span>🚚 ঢাকার বাইরে (Outside Dhaka):</span>
                                            <span class="font-semibold text-white">২-৪ দিন | ১২০ TK</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Order Buttons -->
                        <div class="p-6 pt-0 flex gap-3">
                            <button onclick="orderWhatsApp('${product.name}', '${product.model}', '${product.price}')" 
                                class="flex-1 bg-green-500 hover:bg-green-400 text-slate-950 font-bold py-3 px-4 rounded-xl transition flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(34,197,94,0.4)]">
                                <i class="fab fa-whatsapp text-lg"></i> WhatsApp
                            </button>
                            <button onclick="orderMessenger('${product.name}', '${product.price}')" 
                                class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-4 rounded-xl transition flex items-center justify-center shadow-[0_0_15px_rgba(37,99,235,0.4)]" title="Messenger-এ অর্ডার করুন">
                                <i class="fab fa-facebook-messenger text-lg"></i>
                            </button>
                        </div>
                    </div>
                `;
                grid.innerHTML += card;
            });

            VanillaTilt.init(document.querySelectorAll(".product-card"));
            gsap.from(".product-card", {
                scrollTrigger: "#product-grid",
                y: 50,
                opacity: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: "power3.out"
            });
        }

        // ==========================================
        // ৪. হোয়াটসঅ্যাপ ও মেসেঞ্জার অর্ডার ফাংশন
        // ==========================================
        function orderWhatsApp(name, model, price) {
            const text = `আসসালামু আলাইকুম! আমি আপনার ওয়েবসাইট থেকে নিচের প্রোডাক্টটি অর্ডার করতে চাই:%0A%0A*প্রোডাক্ট:* ${name}%0A*মডেল:* ${model}%0A*দাম/অফার:* ${price}%0A*ডেলিভারি নিয়ম:* সারা বাংলাদেশে হোম ডেলিভারি চাচ্ছি।%0A%0Aআমার নাম ও ঠিকানা দিচ্ছি:`;
            window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${text}`, '_blank');
        }

        function orderMessenger(name, price) {
            window.open('https://www.facebook.com/share/1Bxmc4HQBE/', '_blank');
        }

        function directChat() {
            const text = `হ্যালো! আমি আপনাদের প্রোডাক্ট ও ডেলিভারি সম্পর্কে জানতে চাচ্ছি।`;
            window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${text}`, '_blank');
        }

        // ==========================================
        // ৫. গুগল শিট থেকে ডেটা ফেচ করার সিস্টেম
        // ==========================================
        async function loadProducts() {
            if (GOOGLE_SHEET_CSV_URL) {
                try {
                    const response = await fetch(GOOGLE_SHEET_CSV_URL);
                    const data = await response.text();
                    const rows = data.split('\n').slice(1);
                    const sheetProducts = rows.filter(r => r.trim() !== '').map((row, index) => {
                        const cols = row.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/);
                        const cleanVal = (val) => val ? val.replace(/^"|"$/g, '').trim() : '';
                        
                        return {
                            id: index + 1,
                            name: cleanVal(cols[0]),
                            model: cleanVal(cols[1]),
                            price: cleanVal(cols[2]),
                            badge: cleanVal(cols[3]),
                            image: cleanVal(cols[4]),
                            desc: cleanVal(cols[6]) || cleanVal(cols[5])
                        };
                    });
                    if (sheetProducts.length > 0) products = sheetProducts;
                } catch (e) {
                    console.error("Google Sheet লোড হতে সমস্যা হয়েছে, ডিফল্ট প্রোডাক্ট দেখানো হচ্ছে।", e);
                }
            }
            renderProducts(products);
        }

        gsap.from(".hero-content > *", {
            y: 30,
            opacity: 0,
            duration: 1,
            stagger: 0.2,
            ease: "power3.out"
        });

        loadProducts();
    </script>
</body>
