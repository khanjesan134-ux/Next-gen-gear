                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80" 
                     alt="Premium Gadget" 
                     class="w-72 h-72 md:w-80 md:h-80 object-cover rounded-3xl shadow-[0_0_40px_rgba(56,189,248,0.4)] animate-float z-10 border border-sky-400/30">
